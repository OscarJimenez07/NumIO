# PostgreSQL
POSTGRES_USER=numio
POSTGRES_PASSWORD=numio
POSTGRES_DB=numio

# Backend
DATABASE_URL=postgresql://numio:numio@db:5432/numio
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
NODE_ENV=production

# Swagger (true para activarlo en producción; en dev siempre activo)
SWAGGER_ENABLED=false

# Frontend (build-time)
VITE_API_URL=http://localhost:3000
