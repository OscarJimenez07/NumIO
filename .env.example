# PostgreSQL
POSTGRES_USER=numio
POSTGRES_PASSWORD=numio
POSTGRES_DB=numio

# Backend
DATABASE_URL=postgresql://numio:numio@db:5432/numio
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
NODE_ENV=production

# Swagger (true para activarlo en producción; en dev siempre activo)
SWAGGER_ENABLED=false

# Frontend (build-time)
VITE_API_URL=/api

# Ingreso con la cuenta institucional (Microsoft Entra ID).
# Si estas tres quedan vacías, la plataforma sigue funcionando solo con
# correo y contraseña y el botón de Microsoft ni siquiera aparece.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_ALLOWED_DOMAINS=uts.edu.co
